{
    "name": "laramailer/laravel",
    "description": "Laravel mail transport and PHP SDK for LaraMailer",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "LaraMailer\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraMailer\\Sdk\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "symfony/mailer": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraMailer\\Sdk\\LaraMailerServiceProvider"
            ],
            "aliases": {
                "LaraMailer": "LaraMailer\\Sdk\\Facades\\LaraMailer"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
